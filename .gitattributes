# Keep core runtime code visible in language statistics.
crates/** linguist-vendored=false
apps/daemon/** linguist-vendored=false
apps/web/src/** linguist-vendored=false
apps/web/overlays/** linguist-vendored=false
python/tts/** linguist-vendored=false
python/*.py linguist-vendored=false

# Generated frontend artifacts and API bindings.
apps/web/src/generated/** linguist-generated=true
apps/web/dist/** linguist-generated=true
**/dist/** linguist-generated=true
**/build/** linguist-generated=true
**/*.min.js linguist-generated=true
**/*.min.css linguist-generated=true

# Vendored/runtime asset trees and caches.
node_modules/** linguist-vendored=true
runtime/** linguist-vendored=true
models/** linguist-vendored=true
data/** linguist-vendored=true
logs/** linguist-vendored=true
target/** linguist-generated=true
reports/** linguist-generated=true
eval/** linguist-vendored=true
Liver2d/** linguist-vendored=true

# Documentation and planning content should not dominate language mix.
docs/** linguist-documentation=true
*.md linguist-documentation=true
