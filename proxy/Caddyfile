:18080 {
  encode gzip

  # Unified runtime compatibility gateway.
  # All active APIs and overlays terminate at the single daemon on :8080.

  # Legacy browser-source bookmarks can keep using /live2d.
  handle_path /live2d* {
    redir /overlay/live2d 302
  }

  reverse_proxy 127.0.0.1:{$MANAGER_PORT:8080}
}
