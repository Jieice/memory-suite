# Memory SoVITS-TTS Adapter

TTS_SERVICE_PORT=4014
TTS_SERVICE_HOST=127.0.0.1
TTS_PUBLIC_URL=http://127.0.0.1:4014

AUDIO_CACHE_DIR=./audio_cache
TTS_MAX_DURATION_SEC=45
TTS_SAMPLE_RATE=12000
TTS_CHANNELS=1
TTS_BIT_DEPTH=16

# GPT-SoVITS 后端地址（推荐使用 V2/V4/V2Pro 版本，见 README）
SOVITS_API_URL=http://127.0.0.1:9880
SOVITS_TTS_URL=
SOVITS_TIMEOUT_MS=45000
SOVITS_REF_AUDIO=
SOVITS_REF_TEXT=
SOVITS_REF_LANGUAGE=zh
SOVITS_TARGET_LANGUAGE=zh
SOVITS_SPEED=1.0
SOVITS_TEXT_SPLIT_METHOD=cut5
SOVITS_BATCH_SIZE=1
SOVITS_FRAGMENT_INTERVAL=0.3
SOVITS_MEDIA_TYPE=wav
SOVITS_STREAMING_MODE=false
SOVITS_TOP_K=15
SOVITS_TOP_P=1.0
SOVITS_TEMPERATURE=1.0

TTS_LANGUAGE=zh-CN
TTS_VOICE_ID=1
