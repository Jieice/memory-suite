{
  "id": "manager_control",
  "name": "Manager Control (Creator Backstage)",
  "version": "1.0.0",
  "entry": "bin/control.js",
  "runtime": "node",
  "enabledByDefault": true,
  "confirmationLevel": "notify",
  "accessLevel": "admin",
  "schemas": [
    {
      "name": "manager_control",
      "description": "Creator backstage control tool for the unified runtime: queue TTS, inspect runtime overview, and manage Live2D subtitle state.",
      "input": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "live_say",
              "live2d_subtitle",
              "live2d_clear_subtitle",
              "mu_live_status",
              "tts_synthesize"
            ],
            "description": "Action to execute"
          },
          "text": { "type": "string", "description": "Text content (subtitle or speech)" },
          "durationMs": { "type": "number", "description": "Duration in milliseconds (subtitle)" }
        },
        "required": ["action"]
      },
      "output": {
        "type": "object",
        "properties": {
          "action": { "type": "string" },
          "success": { "type": "boolean" },
          "result": { "type": "object" }
        }
      }
    }
  ],
  "permissions": {
    "filesystem": {
      "write": ["data/tool-outputs/<toolId>/"],
      "screenshot": []
    },
    "network": {
      "enabled": true,
      "visible": true,
      "enforcement": "best_effort"
    }
  },
  "timeout": 30000
}
