{
  "id": "echo",
  "name": "Echo Tool",
  "version": "1.0.0",
  "entry": "bin/echo.js",
  "runtime": "node",
  "enabledByDefault": true,
  "confirmationLevel": "auto",
  "accessLevel": "public",
  "schemas": [
    {
      "name": "echo",
      "description": "Echo back the input message",
      "input": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Message to echo"
          }
        },
        "required": ["message"]
      },
      "output": {
        "type": "object",
        "properties": {
          "echoed": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    }
  ],
  "permissions": {
    "filesystem": {
      "write": ["data/tool-outputs/<toolId>/"],
      "screenshot": []
    },
    "network": {
      "enabled": false,
      "visible": false
    }
  },
  "timeout": 5000
}
